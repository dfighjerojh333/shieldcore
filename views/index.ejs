}
.dl-overlay.active{opacity:1;pointer-events:auto}
.dl-box{
  background:#fff;border-radius:20px;max-width:500px;width:92%;
  padding:2.5rem 2rem;text-align:center;
  transform:scale(0.92) translateY(20px);
  transition:transform .4s cubic-bezier(0.34,1.56,0.64,1);
  position:relative;overflow:hidden;
}
.dl-overlay.active .dl-box{transform:scale(1) translateY(0)}
.dl-box::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--blue),var(--blue-light))}
.dl-shield{
  width:80px;height:80px;border-radius:50%;
  background:linear-gradient(135deg,rgba(0,87,255,0.1),rgba(0,87,255,0.05));
  display:flex;align-items:center;justify-content:center;
