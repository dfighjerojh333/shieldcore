  font-size:2rem;animation:arrow-bounce 0.7s ease-in-out infinite alternate;
  display:inline-block;color:var(--blue);
}
@keyframes arrow-bounce{from{transform:translateY(0)}to{transform:translateY(-6px)}}
.dl-arrows-row p{font-size:0.875rem;font-weight:600;color:var(--text);text-align:left;line-height:1.4}
