<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --blue:#0057FF;
  --blue-dark:#0040CC;
  --blue-light:#3D7FFF;
  --red:#E8003D;
  --green:#00C853;
  --bg:#F4F6FB;
  --white:#FFFFFF;
  --dark:#0A0E1A;
  --text:#1A2035;
  --muted:#6B7390;
  --border:#DDE2F0;
  --card:#FFFFFF;
  --hero-bg:#0A0E1A;
}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden}
a{text-decoration:none;color:inherit}
.container{max-width:1160px;margin:0 auto;padding:0 1.5rem}

/* ─── NAV ─── */
nav{
  background:var(--hero-bg);
  border-bottom:1px solid rgba(255,255,255,0.07);
  position:sticky;top:0;z-index:100;
}
.nav-inner{display:flex;align-items:center;justify-content:space-between;padding:0.85rem 1.5rem;max-width:1160px;margin:0 auto}
.logo{display:flex;align-items:center;gap:0.6rem;font-family:'Barlow Condensed',sans-serif;font-size:1.5rem;font-weight:800;color:#fff;letter-spacing:0.5px}
.logo-icon{width:36px;height:36px;background:var(--blue);border-radius:8px;display:flex;align-items:center;justify-content:center}
.logo-icon svg{width:22px;height:22px;fill:none;stroke:#fff;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.nav-links{display:flex;gap:2rem;font-size:0.875rem;color:rgba(255,255,255,0.6)}
.nav-links a:hover{color:#fff}
.nav-cta{background:var(--blue);color:#fff;font-weight:600;font-size:0.875rem;padding:0.55rem 1.4rem;border-radius:8px;transition:background .2s}
.nav-cta:hover{background:var(--blue-dark)}

/* ─── HERO ─── */
.hero{
  background:var(--hero-bg);
  position:relative;
  overflow:hidden;
  padding:4rem 0 3.5rem;
}
.hero::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(ellipse 70% 60% at 60% 40%, rgba(0,87,255,0.18) 0%, transparent 70%),
    radial-gradient(ellipse 40% 40% at 90% 80%, rgba(0,200,83,0.08) 0%, transparent 60%);
  pointer-events:none;
}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;position:relative;z-index:1}

.hero-badge{
  display:inline-flex;align-items:center;gap:0.5rem;
  background:rgba(0,200,83,0.12);
  border:1px solid rgba(0,200,83,0.3);
  border-radius:100px;padding:0.4rem 1rem;
  font-size:0.8rem;font-weight:600;color:#00C853;
  margin-bottom:1.25rem;
  animation:badge-pulse 3s ease-in-out infinite;
}
@keyframes badge-pulse{0%,100%{box-shadow:0 0 0 0 rgba(0,200,83,0.2)}50%{box-shadow:0 0 0 8px rgba(0,200,83,0)}}
.badge-dot{width:7px;height:7px;border-radius:50%;background:#00C853;animation:blink 1.2s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}

.hero h1{
  font-family:'Barlow Condensed',sans-serif;
  font-size:clamp(2.6rem,5vw,3.8rem);
  font-weight:800;line-height:1.05;
  color:#fff;letter-spacing:-0.5px;
  margin-bottom:1.1rem;
}
.hero h1 .accent{color:var(--blue-light)}
.hero-sub{color:rgba(255,255,255,0.6);font-size:1rem;max-width:26rem;margin-bottom:2rem;line-height:1.7}

.btn-download{
  display:inline-flex;align-items:center;gap:0.75rem;
  background:linear-gradient(135deg,#0057FF,#0040CC);
  color:#fff;font-weight:700;font-size:1.05rem;
  padding:1rem 2.2rem;border-radius:10px;border:none;cursor:pointer;
  box-shadow:0 8px 28px rgba(0,87,255,0.45);
  transition:transform .2s,box-shadow .2s;
  position:relative;overflow:hidden;
  font-family:'DM Sans',sans-serif;
}
.btn-download::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(255,255,255,.15),transparent);
  opacity:0;transition:opacity .2s;
}
.btn-download:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(0,87,255,0.55)}
.btn-download:hover::before{opacity:1}
.btn-download:active{transform:translateY(0)}
.btn-download svg{width:22px;height:22px;fill:#fff;flex-shrink:0}

.hero-note{display:flex;align-items:center;gap:1.5rem;margin-top:1rem;font-size:0.8rem;color:rgba(255,255,255,0.45)}
.hero-note span{display:flex;align-items:center;gap:0.3rem}
.hero-note svg{width:14px;height:14px;stroke:#00C853;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}

/* Shield illustration */
.hero-visual{display:flex;justify-content:center;align-items:center;position:relative}
.shield-wrap{position:relative;animation:float 5s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
.shield-svg{width:260px;height:auto;filter:drop-shadow(0 20px 60px rgba(0,87,255,0.4))}
.scan-line{
  position:absolute;top:18%;left:50%;width:60%;height:2px;
  background:linear-gradient(90deg,transparent,rgba(0,200,83,0.8),transparent);
  transform:translateX(-50%);
  animation:scan 2.5s ease-in-out infinite;
}
@keyframes scan{0%{top:18%;opacity:0}10%{opacity:1}90%{opacity:1}100%{top:82%;opacity:0}}
.orb{position:absolute;border-radius:50%;animation:orb-pulse 3s ease-in-out infinite}
.orb1{width:180px;height:180px;background:radial-gradient(circle,rgba(0,87,255,0.15),transparent);top:50%;left:50%;transform:translate(-50%,-50%);animation-delay:0s}
.orb2{width:280px;height:280px;background:radial-gradient(circle,rgba(0,87,255,0.07),transparent);top:50%;left:50%;transform:translate(-50%,-50%);animation-delay:1s}
@keyframes orb-pulse{0%,100%{transform:translate(-50%,-50%) scale(1)}50%{transform:translate(-50%,-50%) scale(1.08)}}

/* ─── TRUST BAR ─── */
.trust-bar{background:#fff;border-bottom:1px solid var(--border);padding:0.9rem 0}
.trust-inner{display:flex;align-items:center;justify-content:center;gap:2.5rem;flex-wrap:wrap}
.trust-item{display:flex;align-items:center;gap:0.45rem;font-size:0.82rem;font-weight:600;color:var(--muted)}
.trust-item svg{width:16px;height:16px;fill:none;stroke:var(--blue);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.trust-divider{width:1px;height:20px;background:var(--border)}

/* ─── THREAT ALERT (IP section) ─── */
.threat-section{padding:2.5rem 0}
.threat-card{
  background:#fff;border-radius:14px;
  border:1.5px solid rgba(232,0,61,0.2);
  padding:1.75rem 2rem;
  display:grid;grid-template-columns:auto 1fr auto;
  align-items:center;gap:1.5rem;
  box-shadow:0 4px 24px rgba(232,0,61,0.06);
  position:relative;overflow:hidden;
}
.threat-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--red),#FF6B35);
}
.threat-icon-wrap{
  width:56px;height:56px;border-radius:12px;
  background:rgba(232,0,61,0.08);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}
.threat-icon-wrap svg{width:28px;height:28px;stroke:var(--red);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;animation:threat-shake 4s ease-in-out infinite}
@keyframes threat-shake{0%,90%,100%{transform:rotate(0)}92%{transform:rotate(-5deg)}96%{transform:rotate(5deg)}98%{transform:rotate(-3deg)}}
.threat-body h3{font-size:1.1rem;font-weight:700;color:var(--red);margin-bottom:0.3rem}
.threat-body p{font-size:0.875rem;color:var(--muted)}
.ip-display{
  font-family:'Courier New',monospace;font-size:1.5rem;font-weight:700;
  color:var(--red);background:rgba(232,0,61,0.06);
  border:1px solid rgba(232,0,61,0.15);
  border-radius:8px;padding:0.5rem 1rem;white-space:nowrap;text-align:center;
}
.ip-meta{font-size:0.75rem;color:var(--muted);text-align:center;margin-top:0.25rem}
#ip-flag{font-size:1.1rem}

/* ─── STATS ─── */
.stats{background:#fff;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:2rem 0}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;text-align:center}
.stat-item{padding:0.5rem 1rem;border-right:1px solid var(--border)}
.stat-item:last-child{border-right:none}
.stat-num{font-family:'Barlow Condensed',sans-serif;font-size:2.2rem;font-weight:800;color:var(--blue);line-height:1}
.stat-lbl{font-size:0.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;margin-top:0.2rem}

/* ─── SCAN ANIMATION ─── */
.scan-section{padding:3rem 0;text-align:center;overflow:hidden}
.scan-box{
  background:#fff;border-radius:16px;border:1px solid var(--border);
  padding:2rem;max-width:560px;margin:0 auto;
  box-shadow:0 8px 32px rgba(0,0,0,0.05);
}
.scan-title{font-family:'Barlow Condensed',sans-serif;font-size:1.6rem;font-weight:700;margin-bottom:1.25rem}
.scan-bar-wrap{background:#F4F6FB;border-radius:100px;height:12px;overflow:hidden;margin-bottom:0.75rem}
.scan-bar{height:100%;width:0%;border-radius:100px;background:linear-gradient(90deg,var(--blue),var(--blue-light));transition:width 0.1s linear}
.scan-status{font-size:0.85rem;color:var(--muted);height:1.4rem}
.scan-result{display:none;margin-top:1.25rem;padding:1rem;background:rgba(232,0,61,0.05);border:1px solid rgba(232,0,61,0.15);border-radius:10px}
.scan-result.show{display:block}
.scan-result p{font-weight:700;color:var(--red);font-size:1rem;margin-bottom:0.5rem}
.scan-result .threats-found{font-size:0.875rem;color:var(--muted)}

/* ─── FEATURES ─── */
.features{padding:3.5rem 0}
.section-header{text-align:center;margin-bottom:2.5rem}
.section-tag{font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--blue);margin-bottom:0.5rem}
.section-header h2{font-family:'Barlow Condensed',sans-serif;font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:800;letter-spacing:-0.3px;line-height:1.1}
.section-header p{color:var(--muted);max-width:36rem;margin:0.6rem auto 0;font-size:0.95rem}
.features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}
.feat-card{
  background:#fff;border-radius:14px;border:1px solid var(--border);
  padding:1.5rem;transition:border-color .25s,transform .25s,box-shadow .25s;
}
.feat-card:hover{border-color:var(--blue);transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,87,255,0.1)}
.feat-icon{
  width:48px;height:48px;border-radius:10px;
  background:rgba(0,87,255,0.08);
  display:flex;align-items:center;justify-content:center;margin-bottom:1rem;
}
.feat-icon svg{width:24px;height:24px;stroke:var(--blue);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.feat-card h3{font-size:1rem;font-weight:700;margin-bottom:0.4rem}
.feat-card p{font-size:0.875rem;color:var(--muted);line-height:1.6}

/* ─── HOW IT WORKS ─── */
.how{padding:3.5rem 0;background:#fff;border-top:1px solid var(--border)}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:2.5rem;position:relative}
.steps::before{
  content:'';position:absolute;top:36px;left:calc(16.66% + 1rem);right:calc(16.66% + 1rem);
  height:2px;background:linear-gradient(90deg,var(--blue),var(--blue-light));
  z-index:0;
}
.step{text-align:center;position:relative;z-index:1}
.step-circle{
  width:72px;height:72px;border-radius:50%;
  background:linear-gradient(135deg,var(--blue),var(--blue-light));
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 1rem;
  box-shadow:0 8px 24px rgba(0,87,255,0.3);
  color:#fff;font-family:'Barlow Condensed',sans-serif;font-size:1.6rem;font-weight:800;
}
.step h3{font-size:1rem;font-weight:700;margin-bottom:0.4rem}
.step p{font-size:0.875rem;color:var(--muted);max-width:180px;margin:0 auto}

/* ─── BOTTOM CTA ─── */
.bottom-cta{
  padding:4rem 0;
  background:linear-gradient(135deg,var(--dark) 0%,#0A1A3A 100%);
  text-align:center;position:relative;overflow:hidden;
}
.bottom-cta::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 60% 80% at 50% 50%,rgba(0,87,255,0.2),transparent);
  pointer-events:none;
}
.bottom-cta h2{
  font-family:'Barlow Condensed',sans-serif;
  font-size:clamp(2rem,4vw,3.2rem);font-weight:800;
  color:#fff;margin-bottom:0.75rem;position:relative;letter-spacing:-0.3px;
}
.bottom-cta p{color:rgba(255,255,255,0.55);margin-bottom:2rem;position:relative;font-size:0.95rem}

/* ─── HURRY BANNER ─── */
.hurry{
  display:inline-flex;align-items:center;gap:0.5rem;
  background:rgba(232,0,61,0.15);border:1px solid rgba(232,0,61,0.3);
  border-radius:8px;padding:0.6rem 1.2rem;
  font-weight:700;font-size:0.875rem;color:#ff6b7a;
  margin-bottom:1.5rem;animation:hurry-pulse 2s ease-in-out infinite;
}
@keyframes hurry-pulse{0%,100%{box-shadow:0 0 0 0 rgba(232,0,61,0.3)}50%{box-shadow:0 0 0 8px rgba(232,0,61,0)}}
.spots{color:#fff;font-family:monospace;background:var(--red);padding:0.1rem 0.45rem;border-radius:4px;margin-left:4px}

/* ─── FOOTER ─── */
footer{background:var(--dark);border-top:1px solid rgba(255,255,255,0.07);padding:2.5rem 0 1.5rem}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:2rem;margin-bottom:2rem}
.footer-brand p{font-size:0.85rem;color:rgba(255,255,255,0.4);margin-top:0.75rem;max-width:18rem;line-height:1.6}
.footer-col h4{font-size:0.8rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:rgba(255,255,255,0.4);margin-bottom:0.75rem}
.footer-col ul{list-style:none;display:flex;flex-direction:column;gap:0.4rem}
.footer-col ul a{font-size:0.875rem;color:rgba(255,255,255,0.55);transition:color .2s;cursor:pointer}
.footer-col ul a:hover{color:#fff}
.footer-bottom{padding-top:1.5rem;border-top:1px solid rgba(255,255,255,0.07);font-size:0.78rem;color:rgba(255,255,255,0.3);text-align:center}

/* ─── MODALS ─── */
.modal-overlay{position:fixed;inset:0;background:rgba(10,14,26,0.8);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:1000;opacity:0;pointer-events:none;transition:opacity .3s}
.modal-overlay.active{opacity:1;pointer-events:auto}
.modal-box{background:#fff;border-radius:16px;width:90%;max-width:760px;max-height:82vh;display:none;flex-direction:column;overflow:hidden;transform:translateY(24px);transition:transform .3s;border:1px solid var(--border)}
.modal-overlay.active .modal-box{transform:translateY(0)}
.modal-box.visible{display:flex}
.modal-header{padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;background:#fff}
.modal-header h3{font-size:1.1rem;font-weight:700}
.modal-close{background:none;border:none;cursor:pointer;color:var(--muted);font-size:1.5rem;line-height:1;padding:0.25rem;transition:color .2s}
.modal-close:hover{color:var(--red)}
