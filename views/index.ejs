<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: Arial, Helvetica, sans-serif; background: #fff; color: #222; font-size: 14px; overflow: hidden; height: 100vh; }

/* Google top bar (background) */
.top-bar {
  display: flex; align-items: center; padding: 10px 20px;
  border-bottom: 1px solid #e0e0e0; background: #fff;
}
.google-logo-img { height: 30px; margin-right: 30px; }
.search-bar {
  flex: 1; max-width: 580px; display: flex; align-items: center;
  border: 1px solid #dfe1e5; border-radius: 24px; padding: 6px 16px;
  box-shadow: 0 1px 6px rgba(32,33,36,0.08);
}
.search-bar input { flex: 1; border: none; outline: none; font-size: 16px; background: transparent; }
.top-right { margin-left: auto; display: flex; align-items: center; gap: 14px; }
.top-right .grid-icon { font-size: 20px; color: #5f6368; cursor: pointer; }
.top-right .avatar {
  width: 32px; height: 32px; border-radius: 50%;
  background: #1a73e8; color: #fff; display: flex;
  align-items: center; justify-content: center; font-size: 14px; font-weight: bold;
}

.tabs-bar {
  display: flex; align-items: center; padding: 0 20px 0 152px;
  border-bottom: 1px solid #e0e0e0; font-size: 13px;
}
.tabs-left { display: flex; gap: 0; }
.tabs-left a {
  color: #5f6368; text-decoration: none; padding: 10px 16px;
  border-bottom: 3px solid transparent;
}
.tabs-left a.active { color: #1a73e8; border-bottom-color: #1a73e8; font-weight: 500; }
.tabs-right { margin-left: auto; display: flex; gap: 16px; padding-right: 10px; }
.tabs-right a { color: #5f6368; text-decoration: none; padding: 10px 8px; }

/* Fake search results behind modal */
.fake-results {
  max-width: 650px; margin: 0 auto; padding: 24px 20px;
  filter: blur(2px); opacity: 0.6;
}
.fake-result { margin-bottom: 22px; }
.fake-result .url { font-size: 12px; color: #202124; }
.fake-result .title { font-size: 18px; color: #1a0dab; margin: 4px 0; }
.fake-result .desc { font-size: 13px; color: #4d5156; line-height: 1.5; }

/* Dark overlay */
.overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.72);
  display: flex; align-items: center; justify-content: center;
  z-index: 9999; padding: 20px;
  animation: fadeIn 0.3s ease-out;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes pop { 0% { transform: scale(0.85); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(217,48,37,0.5); }
  50% { box-shadow: 0 0 0 18px rgba(217,48,37,0); }
}

/* Modal */
.modal {
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 25px 70px rgba(0,0,0,0.5);
  max-width: 560px; width: 100%;
  overflow: hidden;
  animation: pop 0.35s cubic-bezier(.2,.9,.3,1.2);
  border: 1px solid #e0e0e0;
}
.modal-header {
  background: #d93025;
  color: #fff;
  padding: 14px 22px;
  display: flex; align-items: center; gap: 10px;
  font-size: 15px; font-weight: 600;
}
.modal-header .lock-ico {
  width: 22px; height: 22px;
  display: flex; align-items: center; justify-content: center;
}
.modal-header .url-fake {
  margin-left: auto;
  font-size: 12px; opacity: 0.85;
  font-family: monospace;
}

.modal-body { padding: 28px 32px 24px 32px; }

.title-row {
  display: flex; align-items: center; gap: 18px; margin-bottom: 22px;
}
.g-icon-wrap {
  position: relative; flex-shrink: 0;
  width: 80px; height: 80px;
  animation: pulse 1.8s infinite;
  border-radius: 50%;
}
.g-icon-wrap svg { width: 80px; height: 80px; display: block; }
.g-icon-wrap .alert-badge {
  position: absolute; bottom: -2px; right: -4px;
  width: 28px; height: 28px; border-radius: 50%;
  background: #f4b400; color: #fff; font-size: 18px; font-weight: bold;
  display: flex; align-items: center; justify-content: center;
  border: 3px solid #fff; line-height: 1;
}
.title-text h1 {
  font-size: 22px; font-weight: 700; color: #d93025;
  line-height: 1.25; margin-bottom: 4px;
}
.title-date { color: #70757a; font-size: 12px; }

.warning-p1 {
  color: #d93025; font-size: 15px; line-height: 1.6;
  margin-bottom: 14px;
  background: #fce8e6;
  padding: 12px 14px;
  border-left: 4px solid #d93025;
  border-radius: 4px;
}
.warning-p1 .bold { font-weight: bold; }

.info-p {
  color: #222; font-size: 14px; line-height: 1.65; margin-bottom: 12px;
}
.info-p .bold { font-weight: bold; }

.step-p {
  color: #222; font-size: 14px; margin: 16px 0 18px;
  font-weight: 500;
}
.step-p .bold { font-weight: bold; }

.action-row {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 14px;
  border-top: 1px solid #eee;
  gap: 16px;
}
.timer-text {
  color: #d93025; font-size: 14px; font-weight: 600;
  display: flex; align-items: center; gap: 6px;
}
.timer-text::before {
  content: ''; width: 8px; height: 8px; border-radius: 50%;
  background: #d93025; animation: blink 1s infinite;
}
@keyframes blink { 50% { opacity: 0.2; } }

/* Step 2 — download instruction overlay */
.step2-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.88);
  z-index: 100000;
  display: none;
  align-items: center; justify-content: center;
  padding: 20px;
  animation: fadeIn 0.3s ease-out;
}
.step2-overlay.active { display: flex; }
.step2-content {
  text-align: center;
  color: #fff;
  max-width: 700px;
  animation: pop 0.4s cubic-bezier(.2,.9,.3,1.2);
}
.step2-content h2 {
  font-size: 38px; font-weight: 700; line-height: 1.25;
  margin-bottom: 18px;
  text-shadow: 0 2px 12px rgba(0,0,0,0.5);
}
.step2-content h2 .hl { color: #f4b400; }
.step2-content p {
  font-size: 18px; line-height: 1.5;
  color: #e8eaed; margin-bottom: 14px;
}
.step2-content .file-row {
  display: inline-flex; align-items: center; gap: 12px;
  background: #fff; color: #222;
  padding: 12px 20px; border-radius: 8px;
  margin-top: 24px; font-size: 15px; font-weight: 600;
  box-shadow: 0 8px 30px rgba(0,0,0,0.5);
  text-decoration: none;
}
.step2-content .file-row .file-ico {
  width: 32px; height: 32px;
  background: #1a73e8; border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: bold; font-size: 12px;
}

/* Arrow pointing to top-right (downloads icon) */
.arrow-pointer {
  position: fixed;
  top: 60px; right: 60px;
  z-index: 100001;
  width: 240px; height: 240px;
  pointer-events: none;
  animation: arrowBounce 1.2s ease-in-out infinite;
}
@keyframes arrowBounce {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(20px, -20px); }
}
.arrow-pointer svg {
  width: 100%; height: 100%;
  filter: drop-shadow(0 0 18px rgba(244,180,0,0.9));
}

/* И в самом низу стилей есть правило для мобилок: */
@media (max-width: 600px) {
  .arrow-pointer { width: 160px; height: 160px; top: 40px; right: 30px; }
}
</style>
</head>
